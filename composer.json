{
  "name": "gvntrck/checkout-woo",
  "description": "GVN Checkout for WooCommerce — Checkout personalizado e otimizado com order bump e alta conversão.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "GVN Track",
      "homepage": "https://projetoalfa.org"
    }
  ],
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "squizlabs/php_codesniffer": "^3.9",
    "wp-coding-standards/wpcs": "^3.1",
    "phpcompatibility/php-compatibility": "^9.3",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpstan/phpstan": "^1.11",
    "szepeviktor/phpstan-wordpress": "^1.3",
    "phpunit/phpunit": "^9.6"
  },
  "autoload": {
    "psr-4": {
      "GVN\\Checkout\\": "src/"
    },
    "classmap": [
      "includes/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "GVN\\Checkout\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "scripts": {
    "syntax": "bash scripts/syntax-check.sh",
    "lint": "phpcs",
    "lint:fix": "phpcbf",
    "analyse": "phpstan analyse",
    "test": "phpunit --testsuite unit",
    "test:all": "phpunit",
    "check": [
      "@syntax",
      "@lint",
      "@analyse",
      "@test"
    ],
    "build:zip": "bash scripts/build-zip.sh"
  }
}
