includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 1
    paths:
        - gvn-checkout.php
        - includes/
        - templates/
        - uninstall.php
    excludePaths:
        - vendor/
        - node_modules/
        - tests/fixtures/
    ignoreErrors:
        - '#Constant [A-Z_]+ not found#'
